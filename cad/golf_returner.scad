// ===========================================================================
//  Automatic Putting-Cup Ball Return  -  rubber-band "snap kicker"
//  Mutilated (sector) gear + gear rack + rubber bands, NEMA17 + 3.5:1 gearbox
// ---------------------------------------------------------------------------
//  Render a single part:
//    openscad -D 'part="base"' -o ../stl/base.stl golf_returner.scad
//  Parts: base ramp sled crossbar guide sector pinion spacer lid
//  Views: assembly, section          (cycle_deg animates the mechanism)
//
//  Coordinate system (assembled):
//    +X  = away from the golfer (ball rolls in along +X, is kicked back -X)
//    +Y  = to the golfer's left, Z up, origin at the front edge of the base
//    The ramp sits in front of the base at negative X.
// ===========================================================================
use <lib/gears.scad>
include <stroke_table.scad>   // generated by docs/sector_sim.py

part      = "assembly";
cycle_deg = 0;        // sector rotation from the "ready" (park) position
show_lid  = false;    // assembly view only
$fn       = 64;
eps       = 0.01;

// --------------------------- golf ball ------------------------------------
ball_d = 42.67;
ball_r = ball_d / 2;

// --------------------------- base box -------------------------------------
L       = 184;            // length (X)
Y0      = -30;            // right-hand outer face (golfer's view: right)
Y1      = 76;             // left-hand outer face
H       = 50;             // wall height = lid seat
floor_t = 2.5;
wall    = 3;

ch_half   = 24;           // ball channel half width (48 mm, ball is 42.7)
chw_l     = [Y0, -ch_half];         // channel wall on the -Y side (= outer wall)
chw_r     = [ch_half, 30];          // channel wall on the +Y side
ch_end    = 101;          // channel side walls end here

// pocket floor profile (ball rolls over the crest, drops into a dip,
// then the floor falls gently toward the paddle so the ball follows it)
crest_z      = 16;        // height where the ramp meets the base
pocket_z     = 6;         // bottom of the dip
dip_len      = 28;
pocket_slope = 2.5;       // deg, falling toward +X
pocket_end   = 99;
function floor_z(x) = x < dip_len
    ? pocket_z + (crest_z - pocket_z) * (1 + cos(180 * x / dip_len)) / 2
    : pocket_z - (x - dip_len) * tan(pocket_slope);

// --------------------------- kicker / sled --------------------------------
paddle_x  = 52;           // paddle face at rest (sled fully forward)
paddle_t  = 4;
paddle_hw = 20;           // half width
paddle_z0 = 7;
top_z     = 53;           // top of beam flange / paddle
beam_x1   = 140;          // rear end of beam at rest
beam_hw   = 5;            // beam body half width
beam_z0   = 41.5;         // beam underside (outside the rack)
flange_hw = 8;
flange_z0 = 50;
stroke    = 35;           // simulated 33.4 mm (docs/sector_sim.py) + margin

// --------------------------- gear train -----------------------------------
ax_x   = 115;             // sector / output axle (M5 bolt, along Y)
ax_z   = 27;
sec_m  = 1.5;   sec_z = 16;   sec_teeth = [0, 1, 2, 3, 4];   sec_gap_r = 9.5;
sec_y  = [-4, 4];         // sector face (rack is 7.6 wide)
big_m  = 1;     big_z = 42;   big_y = [12, 20];
pin_z  = 12;              // motor pinion teeth (m1) -> ratio 42/12 = 3.5
pin_x  = 0.35;            // profile shift: +0.35 pinion / -0.35 gear (no undercut,
                          // centre distance unchanged)
rp_sec = sec_m * sec_z / 2;                       // 12
rack_pitch_z = ax_z + rp_sec;                     // 39
cd_motor = big_m * (big_z + pin_z) / 2;           // 27
mot_z  = floor_t + 0.5 + 42.3 / 2;                // motor centre height
mot_x  = ax_x + sqrt(cd_motor * cd_motor - (ax_z - mot_z) * (ax_z - mot_z));
mot_plate_y = [26, 30];   // motor face sits on y = 30, shaft points -Y

// rack: tooth gap centred over the axle when the sled is at rest
rack_p  = PI * sec_m;
rack_n  = 10;
rack_shift = 1.5;         // rest phase: centre of the clean-entry window (see sim)
rack_x0 = ax_x + rack_p / 2 - (rack_n - 1) * rack_p + rack_shift;   // first tooth centre
rack_hw = 3.8;

// sector cycle kinematics (rotation is CW seen from +Y = "top moves +X")
park_rot = -(45 + 180 - 90);      // toothless arc centred on top
// sled travel vs sector angle, from the 2D contact simulation:
// first tooth bites at ~100 deg, last tooth slips off (SNAP) at ~266 deg
function rack_disp(a) = lookup(a % 360, stroke_tbl);

// --------------------------- rubber bands ---------------------------------
band_y      = 27;                 // band centre line (both sides)
frame_pin_x = [26, 34, 42];       // 3 preload settings
xbar_x      = [128, 140];
xbar_pin_x  = 134;
pin_d       = 6;
pin_base_z  = 59;                 // bands run at ~z 62, above the guide rail

// --------------------------- guide rail -----------------------------------
guide_x  = [94, 125];             // rear face = front stop (add 3 mm bumper)
gfront_x = [94, 101];
grear_x  = [113, 125];
g_top    = [53.4, 58.4];
g_wall   = 11.4;                  // outer half width of C-channel
clr      = 0.4;

// --------------------------- sensors / electronics ------------------------
ball_rest_x = paddle_x - ball_r;
ball_rest_z = floor_z(ball_rest_x) + ball_r;
pcb_holes   = [[40, 34], [96, 34], [40, 70], [96, 70]];  // 40x60 perfboard
lid_screws  = [[8, 27], [8, 70], [176, 70], [176, 34]];

// ===========================================================================
//  helpers
// ===========================================================================
module xz_extrude(y0, y1) {          // 2D (x,z) profile -> solid y0..y1
    translate([0, y1, 0]) rotate([90, 0, 0]) linear_extrude(y1 - y0) children();
}
module box(x, y, z) { translate([x[0], y[0], z[0]]) cube([x[1]-x[0], y[1]-y[0], z[1]-z[0]]); }
module ycyl(x, z, d, y0, y1) { translate([x, y1, z]) rotate([90, 0, 0]) cylinder(d = d, h = y1 - y0); }
module zcyl(x, y, d, z0, z1) { translate([x, y, z0]) cylinder(d = d, h = z1 - z0); }

// ===========================================================================
//  BASE
// ===========================================================================
module pocket_floor2d() {
    polygon(concat([[0, 0]],
        [for (i = [0 : 60]) let(x = pocket_end * i / 60) [x, floor_z(x)]],
        [[pocket_end, 0]]));
}

module band_pin(x, y, z0) {
    zcyl(x, y, pin_d, z0, z0 + 7);
    translate([x, y, z0 + 7]) cylinder(d1 = pin_d + 3, d2 = pin_d + 1, h = 2);
}

module dovetail2d(grow = 0) {         // in XY, tab pointing +X from x = 0
    polygon([[-1, -3 - grow], [12 + grow, -5 - grow], [12 + grow, 5 + grow], [-1, 3 + grow]]);
}

module base() {
    difference() {
        union() {
            box([0, L], [Y0, Y1], [0, floor_t]);                     // floor
            box([0, L], chw_l, [0, H]);                              // -Y outer / channel wall
            box([0, ch_end], chw_r, [0, H]);                         // +Y channel wall
            box([0, wall], [chw_r[1], Y1], [0, H]);                  // front wall (bay)
            box([L - wall, L], [Y0, Y1], [0, H]);                    // rear wall
            box([0, L], [Y1 - wall, Y1], [0, H]);                    // +Y outer wall
            xz_extrude(-ch_half - eps, ch_half + eps) pocket_floor2d();
            box([100, 172], mot_plate_y, [0, H]);                    // motor plate
            // band pin pedestals + pins (3 preload positions each side)
            for (s = [-1, 1]) {
                box([22, 46], [s * band_y - 3, s * band_y + 3], [H - eps, pin_base_z]);
                for (x = frame_pin_x) band_pin(x, s * band_y, pin_base_z - eps);
            }
            // lid bosses
            for (p = lid_screws) if (p[1] > 31) zcyl(p[0], p[1], 8, 0, H);
            // perfboard standoffs
            for (p = pcb_holes) zcyl(p[0], p[1], 6, 0, floor_t + 6);
            // ball-sensor module shelf (TCRT5000 board rests on it)
            box([4, 38], [chw_r[1], chw_r[1] + 4], [17, 19.5]);
            // motor cradle under the motor body
            box([mot_x - 14, mot_x + 14], [34, 66], [0, mot_z - 21.15 - 0.3]);
        }
        // ---- axle (M5) through outer wall and motor plate
        ycyl(ax_x, ax_z, 5.4, Y0 - 1, chw_l[1] + 1);
        ycyl(ax_x, ax_z, 5.4, mot_plate_y[0] - 1, mot_plate_y[1] + 1);
        // ---- NEMA17 boss + screws
        ycyl(mot_x, mot_z, 23, mot_plate_y[0] - 1, mot_plate_y[1] + 1);
        for (dx = [-15.5, 15.5], dz = [-15.5, 15.5])
            ycyl(mot_x + dx, mot_z + dz, 3.4, mot_plate_y[0] - 1, mot_plate_y[1] + 1);
        // ---- ramp dovetail sockets
        for (y = [-12, 12]) translate([0, y, -eps]) linear_extrude(5.3) dovetail2d(0.25);
        // ---- ball sensor: TCRT5000 window (+Y wall), IR break-beam hole (-Y wall)
        box([ball_rest_x - 6.5, ball_rest_x + 6.5], [chw_r[0] - 1, chw_r[1] + 1],
            [ball_rest_z - 3.5, ball_rest_z + 3.5]);
        ycyl(ball_rest_x, ball_rest_z, 5.2, Y0 - 1, chw_l[1] + 1);
        // ---- guide rail screw pilots (M3 self-tapping)
        for (p = [[97.5, -band_y], [97.5, band_y], [119, -band_y], [119, 28]])
            zcyl(p[0], p[1], 2.6, H - 12, H + 1);
        // ---- lid screw pilots
        for (p = lid_screws) zcyl(p[0], p[1], 2.6, H - 12, H + 1);
        // ---- perfboard standoff pilots
        for (p = pcb_holes) zcyl(p[0], p[1], 2.4, 1, floor_t + 7);
        // ---- rear wall: DC jack (11 mm) + KCD1 rocker switch (19 x 12.6)
        translate([L - wall - 1, 60, 25]) rotate([0, 90, 0]) cylinder(d = 11, h = wall + 2);
        box([L - wall - 1, L + 1], [42 - 6.3, 42 + 6.3], [25 - 9.5, 25 + 9.5]);
        // ---- wire pass from the guide-rail switch into the bay
        box([104, 112], [mot_plate_y[0] - 1, mot_plate_y[1] + 1], [H - 6, H + 1]);
        // ---- rubber feet recesses (10 mm bumpons)
        for (p = [[12, Y0 + 10], [12, Y1 - 10], [L - 12, Y0 + 10], [L - 12, Y1 - 10]])
            zcyl(p[0], p[1], 10.5, -1, 0.8);
    }
}

// ===========================================================================
//  RAMP  (bolts on with two dovetails, funnel = regulation cup width 108 mm)
// ===========================================================================
ramp_len = 170;
ramp_hw  = 57;
module ramp() {
    union() {
        translate([0, ramp_hw, 0]) rotate([90, 0, 0]) linear_extrude(2 * ramp_hw)
            polygon([[-ramp_len, 0], [0, 0], [0, crest_z], [-ramp_len, 1.2]]);
        // funnel walls: 108 mm mouth narrowing to the 48 mm channel
        for (s = [-1, 1]) hull() {
            translate([-ramp_len + 2, s * (54 + 1.5), 0]) cylinder(d = 3, h = 1.2 + 10);
            translate([-1.5, s * (ch_half + 1.5), 0]) cylinder(d = 3, h = crest_z + 10);
        }
        for (y = [-12, 12]) translate([0, y, 0]) linear_extrude(5) dovetail2d(0);
    }
}

// ===========================================================================
//  SLED  (paddle + beam + rack). Print upside-down on the flange top.
// ===========================================================================
module sled() {
    difference() {
        union() {
            box([paddle_x, paddle_x + paddle_t], [-paddle_hw, paddle_hw], [paddle_z0, top_z]);
            box([paddle_x, beam_x1], [-beam_hw, beam_hw], [beam_z0, flange_z0 + eps]);
            box([paddle_x, beam_x1], [-flange_hw, flange_hw], [flange_z0, top_z]);
            // gusset behind the paddle
            xz_extrude(-2, 2) polygon([[paddle_x + paddle_t - eps, 12],
                [paddle_x + paddle_t - eps, beam_z0 + eps], [66, beam_z0 + eps]]);
            // rack
            xz_extrude(-rack_hw, rack_hw) translate([0, rack_pitch_z])
                rack2d(sec_m, rack_n, rack_x0, body_h = beam_z0 - rack_pitch_z + 0.5);
        }
        // crossbar screws (M3 x 16, nuts captured underneath)
        for (x = [131, 137]) {
            zcyl(x, 0, 3.3, beam_z0 - 1, top_z + 1);
            translate([x, 0, beam_z0 - 1]) cylinder(d = 6.4, h = 4, $fn = 6);
        }
        // shallow pocket on the paddle face for a felt / foam pad
        box([paddle_x - 1, paddle_x + 1], [-15, 15], [14, 40]);
    }
}

module crossbar() {
    difference() {
        union() {
            box(xbar_x, [-31, 31], [top_z, pin_base_z]);
            box([xbar_x[0], xbar_x[0] + 3], [-10, 10], [top_z + 5 - eps, top_z + 16]);   // switch striker
            for (s = [-1, 1]) band_pin(xbar_pin_x, s * band_y, pin_base_z - eps);
        }
        for (x = [131, 137]) zcyl(x, 0, 3.3, top_z - 1, top_z + 6);
    }
}

// ===========================================================================
//  GUIDE RAIL  (inverted C-channel; its rear face is the sled's front stop)
// ===========================================================================
module guide() {
    difference() {
        union() {
            box(guide_x, [-g_wall, g_wall], [47, g_top[1]]);
            box(gfront_x, [-30, 30], [H, g_top[1]]);
            box(grear_x,  [-30, 30], [H, g_top[1]]);
        }
        // slot for the beam flange and body
        box([guide_x[0] - 1, guide_x[1] + 1], [-flange_hw - clr, flange_hw + clr], [flange_z0 - clr, top_z + clr]);
        box([guide_x[0] - 1, guide_x[1] + 1], [-beam_hw - clr, beam_hw + clr], [40, flange_z0]);
        // mounting screws (M3 x 12)
        for (p = [[97.5, -band_y], [97.5, band_y], [119, -band_y], [119, 28]])
            zcyl(p[0], p[1], 3.4, H - 1, g_top[1] + 1);
        // KW11-3Z microswitch: two M2 slots, 9.5 mm apart (adjustable in X)
        for (y = [-4.75, 4.75]) hull() for (x = [111, 117]) zcyl(x, y, 1.8, g_top[1] - 4, g_top[1] + 1);
    }
}

// ===========================================================================
//  GEARS
// ===========================================================================
module sector_part() {        // compound: 16T m1.5 sector (6 teeth) + 42T m1
    difference() {
        union() {
            xz_extrude(sec_y[0], sec_y[1])
                spur_gear2d(sec_m, sec_z, teeth = sec_teeth, gap_r = sec_gap_r, relief = [0], relief_cut = 0.45);
            // 45 deg support cone under the sector teeth (prints big-gear-down)
            intersection() {
                xz_extrude(sec_y[1] - eps, sec_y[1] + 3) polygon(concat([[0, 0]],
                    [for (i = [0 : 12]) let(pa = 360 / sec_z, a0 = min(sec_teeth) * pa - pa / 2,
                                           a1 = max(sec_teeth) * pa + pa / 2)
                        [20 * cos(a0 + (a1 - a0) * i / 12), 20 * sin(a0 + (a1 - a0) * i / 12)]]));
                translate([0, sec_y[1] + 3, 0]) rotate([90, 0, 0])
                    cylinder(r1 = sec_gap_r, r2 = rp_sec + 0.5, h = 3);
            }
            ycyl(0, 0, 2 * sec_gap_r, sec_y[1] - eps, big_y[0] + eps);         // hub
            xz_extrude(big_y[0], big_y[1]) spur_gear2d(big_m, big_z, x = -pin_x);
            ycyl(0, 0, 12, -23.6, sec_y[0] + eps);                             // left spacer tube
        }
        ycyl(0, 0, 5.4, -30, 30);
    }
}

module pinion_part() {        // 12T m1 on the 5 mm D-shaft of the 17HS4401S
    difference() {
        union() {
            xz_extrude(big_y[0] - 1, big_y[1] + 1) spur_gear2d(big_m, pin_z, x = pin_x);
            ycyl(0, 0, 16, big_y[1] + 1 - eps, 25.5);      // hub clears the 42T face by 1 mm
        }
        // D bore: 5.15 round, flat 4.65 across
        translate([0, 31, 0]) rotate([90, 0, 0]) linear_extrude(40)
            intersection() { circle(d = 5.15, $fn = 40); translate([-3, -2.6]) square([6, 2.6 + 2.05]); }
        // M3 grub screw + nut slot on the flat
        translate([0, 23.25, 0]) cylinder(d = 3.3, h = 10);
        translate([-2.9, 23.25 - 1.4, 3.6]) cube([5.8, 2.8, 10]);
    }
}

module spacer_part() { difference() { ycyl(0, 0, 12, 20.2, 25.8); ycyl(0, 0, 5.4, 19, 27); } }

// ===========================================================================
//  LID
// ===========================================================================
module lid() {
    difference() {
        box([0, L], [ch_half, Y1], [H, H + 2]);
        box([21, 47], [ch_half - 1, 31], [H - 1, H + 3]);     // band pin pedestals
        box([93, 102], [ch_half - 1, 31], [H - 1, H + 3]);    // guide front plate
        box([112, 126], [ch_half - 1, 31], [H - 1, H + 3]);   // guide rear plate
        for (p = lid_screws) {
            zcyl(p[0], p[1], 3.4, H - 1, H + 3);
            zcyl(p[0], p[1], 6, H + 1, H + 3);
        }
        // vent slots over the stepper driver
        for (i = [0 : 5]) box([50 + i * 7, 53 + i * 7], [40, 66], [H - 1, H + 3]);
    }
}

// ===========================================================================
//  print orientations
// ===========================================================================
module print_sector()  { rotate([-90, 0, 0]) translate([0, -big_y[1], 0]) sector_part(); }
module print_pinion()  { rotate([-90, 0, 0]) translate([0, -25.5, 0]) pinion_part(); }
module print_spacer()  { rotate([-90, 0, 0]) translate([0, -25.8, 0]) spacer_part(); }
module print_sled()    { rotate([180, 0, 0]) translate([0, 0, -top_z]) sled(); }
module print_crossbar(){ translate([0, 0, -top_z]) crossbar(); }
module print_guide()   { rotate([180, 0, 0]) translate([0, 0, -g_top[1]]) guide(); }
module print_lid()     { rotate([180, 0, 0]) translate([0, 0, -H - 2]) lid(); }

// ===========================================================================
//  assembly
// ===========================================================================
module motor_dummy() {
    color("DimGray") {
        box([mot_x - 21.15, mot_x + 21.15], [mot_plate_y[1], mot_plate_y[1] + 40], [mot_z - 21.15, mot_z + 21.15]);
        ycyl(mot_x, mot_z, 5, mot_plate_y[1] - 24, mot_plate_y[1]);
    }
}

module bands(dx) {
    for (s = [-1, 1], x = [frame_pin_x[0]]) color("Orange")
        for (o = [-1, 1]) hull() {
            translate([x, s * band_y + o * 3.6, 62]) sphere(d = 1.6, $fn = 8);
            translate([xbar_pin_x + dx, s * band_y + o * 3.6, 62]) sphere(d = 1.6, $fn = 8);
        }
}

module assembly(a = cycle_deg) {
    d = rack_disp(a);
    srot = park_rot - a;                         // CW about +Y
    color("WhiteSmoke") base();
    color("LightGray")  ramp();
    color("SteelBlue")  translate([d, 0, 0]) sled();
    color("SteelBlue")  translate([d, 0, 0]) crossbar();
    color("Gold")       guide();
    color("Crimson")    translate([ax_x, 0, ax_z]) rotate([0, -srot, 0]) sector_part();
    // pinion meshed with the big gear
    beta = atan2(mot_z - ax_z, mot_x - ax_x);
    db   = ((srot - beta) % (360 / big_z) + 360 / big_z) % (360 / big_z);
    prot = beta + 180 + 180 / pin_z - db * big_z / pin_z;
    color("Crimson")    translate([mot_x, 0, mot_z]) rotate([0, -prot, 0]) pinion_part();
    color("Crimson")    translate([ax_x, 0, ax_z]) spacer_part();
    motor_dummy();
    color("Silver") ycyl(ax_x, ax_z, 5, Y0 - 4, mot_plate_y[1] + 4);       // M5 bolt
    color("Black") box([113, 123], [-10, 10], [g_top[1], g_top[1] + 6.4]);  // KW11 switch
    bands(d);
    // ball: resting on the paddle (follows it back while cocking)
    color("White") translate([paddle_x + d - ball_r - 0.2, 0,
                              floor_z(paddle_x + d - ball_r) + ball_r]) sphere(r = ball_r);
    if (show_lid) color("WhiteSmoke", 0.5) lid();
}

module section(a = cycle_deg) {
    difference() { assembly(a); translate([-200, -200 - 0.2, -10]) cube([500, 200, 100]); }
}


// ---------------------------------------------------------------------------
//  interference checking:  part="isect", A="sled", B="sector", cycle_deg=...
// ---------------------------------------------------------------------------
A = ""; B = "";
module placed(n, a = cycle_deg) {
    d = rack_disp(a);
    srot = park_rot - a;
    beta = atan2(mot_z - ax_z, mot_x - ax_x);
    db   = ((srot - beta) % (360 / big_z) + 360 / big_z) % (360 / big_z);
    prot = beta + 180 + 180 / pin_z - db * big_z / pin_z;
    if (n == "base") base();
    if (n == "ramp") ramp();
    if (n == "sled") translate([d, 0, 0]) sled();
    if (n == "crossbar") translate([d, 0, 0]) crossbar();
    if (n == "guide") guide();
    if (n == "lid") lid();
    if (n == "sector") translate([ax_x, 0, ax_z]) rotate([0, -srot, 0]) sector_part();
    if (n == "pinion") translate([mot_x, 0, mot_z]) rotate([0, -prot, 0]) pinion_part();
    if (n == "spacer") translate([ax_x, 0, ax_z]) spacer_part();
    if (n == "motor") motor_dummy();
    if (n == "ball") translate([paddle_x + d - ball_r - 0.2, 0, floor_z(paddle_x + d - ball_r) + ball_r + 0.05]) sphere(r = ball_r);
}

// ===========================================================================
if (part == "isect") intersection() { placed(A); placed(B); }
else if (part == "assembly") assembly();
else if (part == "section") section();
else if (part == "base") base();
else if (part == "ramp") translate([ramp_len, 0, 0]) ramp();
else if (part == "sled") print_sled();
else if (part == "crossbar") print_crossbar();
else if (part == "guide") print_guide();
else if (part == "sector") print_sector();
else if (part == "pinion") print_pinion();
else if (part == "spacer") print_spacer();
else if (part == "lid") print_lid();
